{
  "name": "spec-injector",
  "version": "0.1.0",
  "description": "Deterministic task package generator from GitHub issues",
  "type": "module",
  "files": [
    "dist",
    "bin",
    "docs",
    "presets",
    "README.md"
  ],
  "bin": {
    "spec": "./bin/spec.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "pnpm build && node --test \"tests/**/*.test.ts\"",
    "test:gh": "SPEC_INJECTOR_RUN_GH_TESTS=1 node --test tests/optional-gh.smoke.test.ts",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
